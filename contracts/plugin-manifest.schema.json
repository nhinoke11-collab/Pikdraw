{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pikdraw.example/contracts/plugin-manifest/v1",
  "title": "PikDraw plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "license",
    "host_api",
    "runtime",
    "entrypoint",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX identifier or LicenseRef with bundled license text."
    },
    "host_api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "runtime": {
      "const": "isolated-process"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "description": "Relative executable/script inside plugin package. Host must reject traversal, symlinks escaping package and absolute paths."
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "document.read",
          "document.commands",
          "selection.read",
          "ui.commands",
          "ui.panels",
          "files.user-selected",
          "network.request"
        ]
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "panels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
