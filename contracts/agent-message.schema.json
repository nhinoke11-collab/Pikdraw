{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pikdraw.example/contracts/agent-message/v1",
  "title": "PikDraw transport-neutral agent envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "message_id",
    "kind",
    "task_id",
    "sender",
    "payload"
  ],
  "properties": {
    "protocol": {
      "const": "pikdraw.agent/1"
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "assignment",
        "update",
        "handoff",
        "review"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "agent_id"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "agent_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "payload": {
      "type": "object",
      "description": "Typed task/handoff payload; validation by transport implementation required. This envelope is not yet an implemented network gateway."
    }
  }
}
