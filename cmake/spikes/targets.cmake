if(NOT PIKDRAW_SPIKE_A AND NOT PIKDRAW_SPIKE_B AND NOT PIKDRAW_SPIKE_C)
  message(FATAL_ERROR "Select at least one real spike with -DPIKDRAW_SPIKE_A/B/C=ON; an empty configure is not evidence.")
endif()
get_filename_component(PIKDRAW_SPIKE_SOURCE_ROOT "${PIKDRAW_SPIKE_SOURCE_ROOT}" REALPATH)
set(PIKDRAW_SPIKE_CONTRACT_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../contracts/spikes")
function(pikdraw_spike_module relative_path)
  if(EXISTS "${PIKDRAW_SPIKE_SOURCE_ROOT}/${relative_path}/CMakeLists.txt")
    add_subdirectory("${PIKDRAW_SPIKE_SOURCE_ROOT}/${relative_path}" "lane/${relative_path}")
  endif()
endfunction()
if(PIKDRAW_SPIKE_B)
  pikdraw_spike_module(core/geometry)
  pikdraw_spike_module(core/document)
endif()
if(PIKDRAW_SPIKE_A)
  pikdraw_spike_module(core/rendering)
  pikdraw_spike_module(apps/desktop)
endif()
if(PIKDRAW_SPIKE_C)
  pikdraw_spike_module(modules/interop)
  pikdraw_spike_module(platform/workers)
endif()
foreach(lane A B C)
  if(PIKDRAW_SPIKE_${lane})
    if(lane STREQUAL "A")
      set(required pikdraw_spike_a_viewport)
    elseif(lane STREQUAL "B")
      set(required pikdraw_spike_b_tests)
    else()
      set(required pikdraw_spike_c_tests)
    endif()
    if(NOT TARGET ${required})
      message(FATAL_ERROR "Enabled spike ${lane} has no real target ${required}. Implement it in its owned module; do not substitute a passing stub.")
    endif()
  endif()
endforeach()
