{
  "panel": "topbar",
  "class": "TopbarWidget",
  "height": 38,
  "style": {
    "button_radius": "6px",
    "border_tech": "#1d2636"
  },
  "widgets": [
    { "id": "logo", "class": "QLabel", "text": "PK PRO 2026", "badge": "PRO" },
    { "id": "btn_home", "class": "QPushButton", "text": "Trang chủ", "icon": "home", "action": "action.view.home", "tooltip": "Mở Trang chủ / Welcome Screen (Alt+H)" },
    { "id": "file_title", "class": "QLabel", "text": "Bien_Hieu_An_Phat.pik", "status": "saved" },
    {
      "id": "menu_file",
      "class": "QPushButton",
      "text": "Tệp",
      "action": "menu.file",
      "items": [
        { "id": "file_new", "action": "action.file.new", "text": "Tạo mới...", "shortcut": "Ctrl+N", "icon": "document-new" },
        { "id": "file_new_from_template", "action": "action.file.new_from_template", "text": "Tạo từ mẫu...", "shortcut": "", "icon": "template-new" },
        { "id": "file_open", "action": "action.file.open", "text": "Mở...", "shortcut": "Ctrl+O", "icon": "folder-open" },
        { "id": "file_open_cloud", "action": "action.file.open_cloud", "text": "Mở từ đám mây...", "shortcut": "", "icon": "cloud-download" },
        { "id": "file_open_recent", "action": "action.file.open_recent", "text": "Tệp gần đây", "has_submenu": true, "icon": "history" },
        { "type": "separator" },
        { "id": "file_close", "action": "action.file.close", "text": "Đóng", "shortcut": "Ctrl+W", "icon": "close" },
        { "id": "file_close_all", "action": "action.file.close_all", "text": "Đóng tất cả", "shortcut": "", "icon": "close-all" },
        { "type": "separator" },
        { "id": "file_save", "action": "action.file.save", "text": "Lưu...", "shortcut": "Ctrl+S", "icon": "save" },
        { "id": "file_save_as", "action": "action.file.save_as", "text": "Lưu thành...", "shortcut": "Ctrl+Shift+S", "icon": "save-as" },
        { "id": "file_save_cloud", "action": "action.file.save_cloud", "text": "Lưu lên đám mây...", "shortcut": "", "icon": "cloud-upload" },
        { "id": "file_save_template", "action": "action.file.save_template", "text": "Lưu dưới dạng mẫu...", "shortcut": "", "icon": "save-template" },
        { "id": "file_revert", "action": "action.file.revert", "text": "Khôi phục gốc", "shortcut": "", "icon": "revert", "enabled": false },
        { "type": "separator" },
        { "id": "file_acquire_image", "action": "action.file.acquire_image", "text": "Thu nạp hình ảnh", "has_submenu": true, "icon": "camera" },
        { "id": "file_import", "action": "action.file.import", "text": "Nhập tệp...", "shortcut": "Ctrl+I", "icon": "import" },
        { "id": "file_export", "action": "action.file.export", "text": "Xuất tệp...", "shortcut": "Ctrl+E", "icon": "export" },
        { "id": "file_export_for", "action": "action.file.export_for", "text": "Xuất cho", "has_submenu": true, "icon": "export-for" },
        { "id": "file_export_docker", "action": "action.file.export_docker", "text": "Docker xuất file", "has_submenu": true, "icon": "docker" },
        { "id": "file_send_to", "action": "action.file.send_to", "text": "Gửi đến", "has_submenu": true, "icon": "send" },
        { "id": "file_publish_pdf", "action": "action.file.publish_pdf", "text": "Xuất bản PDF...", "shortcut": "", "icon": "pdf" },
        { "type": "separator" },
        { "id": "file_print_merge", "action": "action.file.print_merge", "text": "Trộn tài liệu in", "has_submenu": true, "icon": "merge" },
        { "id": "file_print", "action": "action.file.print", "text": "In ấn...", "shortcut": "Ctrl+P", "icon": "print" },
        { "id": "file_print_preview", "action": "action.file.print_preview", "text": "Xem trước bản in...", "shortcut": "", "icon": "preview" },
        { "type": "separator" },
        { "id": "file_properties", "action": "action.file.properties", "text": "Thuộc tính tài liệu...", "shortcut": "", "icon": "properties" },
        { "type": "separator" },
        { "id": "file_exit", "action": "action.file.exit", "text": "Thoát", "shortcut": "Alt+F4", "icon": "exit" }
      ]
    },
    { "id": "menu_edit", "class": "QPushButton", "text": "Chỉnh sửa" },
    { "id": "menu_object", "class": "QPushButton", "text": "Đối tượng" },
    { "id": "menu_production", "class": "QPushButton", "text": "Thi công" },
    { "id": "menu_view", "class": "QPushButton", "text": "Hiển thị" },
    { "id": "menu_plugin", "class": "QPushButton", "text": "Plugin" },
    { "id": "spotlight_search", "class": "QLineEdit", "placeholder": "Tìm lệnh, công cụ... (Ctrl+K)" },
    { "id": "workspace_vector", "class": "QPushButton", "text": "Vector" },
    { "id": "workspace_inan", "class": "QPushButton", "text": "In ấn" },
    { "id": "workspace_thicong", "class": "QPushButton", "text": "Thi công" },
    { "id": "workspace_3d", "class": "QPushButton", "text": "3D" },
    { "id": "theme_toggle", "class": "QPushButton", "icon": "sun-moon" },
    { "id": "settings_btn", "class": "QPushButton", "text": "Cài đặt", "icon": "gear" },
    { "id": "lang_toggle", "class": "QPushButton", "text": "VI | EN" },
    { "id": "btn_export", "class": "QPushButton", "text": "Xuất file", "style": "primary" }
  ]
}
