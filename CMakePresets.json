{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "win-dev",
      "displayName": "PikDraw shared Windows build",
      "description": "One source and build tree; use tooling/native/build.ps1 for the shared lock",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PIKDRAW_BUILD_TESTS": "ON",
        "PIKDRAW_ENABLE_WARNINGS_AS_ERRORS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-dev",
      "configurePreset": "win-dev",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "win-dev",
      "configurePreset": "win-dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
